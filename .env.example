# Platform Selection
BETTING_PLATFORM=cloudbet
ALERT_ONLY_MODE=false

# Cloudbet API Configuration
# Get your API key from: https://www.cloudbet.com/en/account/api
# Requires minimum 10 EUR deposit to activate Trading API
CLOUDBET_API_KEY=your_cloudbet_api_key_here
CLOUDBET_CURRENCY=USDT

# Pinnacle API Credentials (Legacy - API access restricted)
# PINNACLE_USERNAME=your_pinnacle_username
# PINNACLE_PASSWORD=your_pinnacle_password
# PINNACLE_API_BASE_URL=https://api.pinnacle.com

# Betting Configuration (amounts in cryptocurrency if using Cloudbet)
# For BTC: 0.001 = ~$70, for USDT: 1 = $1
MIN_ODDS=1.50
MAX_ODDS=4.00
MIN_BET_AMOUNT=1
MAX_BET_AMOUNT=20
MAX_DAILY_LOSS=50
MAX_TOTAL_EXPOSURE=100

# Risk Management (FUNDAMENTAL ANALYSIS MODE - Predict winners based on data)
# NEW STRATEGY: Use team records, rankings, injuries to predict winners
USE_FUNDAMENTAL_ANALYSIS=true
MIN_PREDICTION_CONFIDENCE=0.60
KELLY_FRACTION=0.25
MIN_EDGE_PERCENTAGE=-3.0
MAX_BETS_PER_DAY=10
BANKROLL_PERCENTAGE_PER_BET=1
MIN_BOOKMAKERS=2
MIN_SHARP_BOOKMAKERS=0
MIN_EFFICIENCY_SCORE=5

# The Odds API (for multi-bookmaker comparison and sharp consensus)
# Current plan: 20,000 requests/month (ACTIVE)
# Sufficient for 8+ sports @ 30min updates
# Get your key at: https://the-odds-api.com
ODDS_API_KEY=your_odds_api_key_here

# Sports Data APIs (for fundamental analysis - NBA/NFL/NHL)
# Get free API key at: https://api-sports.io (completely free for NBA/NFL/NHL)
API_SPORTS_KEY=your_api_sports_key_here

# BallDontLie is completely free, no API key needed for basic data

# Logging
LOG_LEVEL=info

# Telegram Notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
